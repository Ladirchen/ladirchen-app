{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "container",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/workbox-(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "daemons": {
    "family-workers": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "command": ["dotnet", "LadirchenApp.Webhost.dll", "--daemon"],
      "instances": {
        "fra1": 1
      },
      "livenessProbe": {
        "httpGet": {
          "path": "/health/live",
          "port": 8081
        },
        "initialDelaySeconds": 120,
        "periodSeconds": 10,
        "timeoutSeconds": 2,
        "failureThreshold": 3
      },
      "terminationGracePeriodSeconds": 60
    }
  }
}
