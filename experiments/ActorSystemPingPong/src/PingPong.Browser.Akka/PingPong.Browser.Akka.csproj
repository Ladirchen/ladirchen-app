<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bootsharp" Version="0.9.0" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Akka.NET resolves several types (actor ref provider, dispatchers, mailboxes, loggers, ...) by name
          from its HOCON configuration via reflection. The browser-wasm linker trims unreferenced members by
          default, which breaks that reflection-based resolution unless the assembly is rooted (kept whole).
        -->
        <TrimmerRootAssembly Include="Akka" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PingPong.Game.Akka\PingPong.Game.Akka.csproj" />
    </ItemGroup>

</Project>
