<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Avoids the project's own namespace segment "Akka" shadowing the Akka.NET package namespace. -->
    <RootNamespace>PingPong.AkkaGame</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.71" />
  </ItemGroup>

</Project>
