{
  "name": "ladirchen-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --build --force && vp build",
    "preview": "vp preview",
    "build-only": "vp build",
    "colors:check": "node ./scripts/color-palette.mjs",
    "colors:generate": "node ./scripts/color-palette.mjs --write",
    "generate:design": "node ./scripts/generate-design.mjs",
    "i18n:check": "node ./scripts/i18n.mjs",
    "styles:check": "node ./scripts/style-quality.mjs",
    "styles:fix": "node ./scripts/style-quality.mjs --write",
    "type-check": "vue-tsc --build --force",
    "lint": "node ./scripts/color-palette.mjs && node ./scripts/i18n.mjs && node ./scripts/style-quality.mjs && eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/roboto": "catalog:dependencies",
    "luxon": "catalog:dependencies",
    "motion-v": "catalog:dependencies",
    "pinia": "catalog:dependencies",
    "pixi.js": "catalog:dependencies",
    "vue": "catalog:dependencies",
    "vue-i18n": "catalog:dependencies",
    "vue-router": "catalog:dependencies",
    "vuetify": "catalog:dependencies"
  },
  "devDependencies": {
    "@iconify-json/mdi": "catalog:devDependencies",
    "@stylistic/eslint-plugin": "catalog:devDependencies",
    "@tsconfig/node22": "catalog:devDependencies",
    "@types/luxon": "catalog:devDependencies",
    "@types/node": "catalog:devDependencies",
    "@unocss/transformer-directives": "catalog:devDependencies",
    "@vitejs/plugin-vue": "catalog:devDependencies",
    "@vue/tsconfig": "catalog:devDependencies",
    "@vuetify/mcp": "catalog:devDependencies",
    "eslint": "catalog:devDependencies",
    "eslint-config-vuetify": "catalog:devDependencies",
    "sass-embedded": "catalog:devDependencies",
    "typescript": "catalog:devDependencies",
    "unocss": "catalog:devDependencies",
    "unocss-preset-vuetify": "catalog:devDependencies",
    "vite": "catalog:devDependencies",
    "vite-plugin-vuetify": "catalog:devDependencies",
    "vite-plus": "catalog:devDependencies",
    "vitest": "catalog:devDependencies",
    "vue-tsc": "catalog:devDependencies"
  },
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  }
}
